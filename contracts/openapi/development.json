  "components": {
    "schemas": {
      "Body_upload_resume_api_v1_resumes_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": "My resume"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_resume_api_v1_resumes_post"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "CriterionView": {
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "met",
              "not_met",
              "unknown",
              "not_applicable"
            ],
            "title": "Verdict"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "reasoning_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Summary"
          },
          "improvement_suggestion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Improvement Suggestion"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Evidence"
          },
          "validation_status": {
            "type": "string",
            "title": "Validation Status"
          },
          "evaluation_criteria": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evaluation Criteria"
          },
          "comparison_basis": {
            "type": "string",
            "title": "Comparison Basis",
            "default": ""
          },
          "estimated": {
            "type": "boolean",
            "title": "Estimated",
            "default": false
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
