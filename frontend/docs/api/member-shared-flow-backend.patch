+++ b/app/api/v1/routes/flow.py
@@ -0,0 +1,79 @@
+"""Read-only observation is available to every authenticated member."""
+import asyncio
+import hashlib
+import json
+
+from fastapi import APIRouter, Depends, HTTPException, Query, Request, Response
+from app.api.v1.routes.api import user
+from app.application.flow import FlowRateLimited, clean_batch, cursor_key, flow_store
+
+router = APIRouter(prefix='/api/v1/flow', tags=['flow'])
+MAX_BODY = 131072
+
+
+def service(request):
+    return getattr(request.app.state, 'flow_store', None) or flow_store(request.app.state.config)
+
+
+async def invoke(request, method, *args):
+    try:
+        return await asyncio.to_thread(getattr(service(request), method), *args)
+    except FlowRateLimited:
+        raise HTTPException(429, '이용 흐름 전송이 많습니다. 잠시 후 다시 연결합니다.', headers={'Retry-After': '60'}) from None
+    except Exception:
+        raise HTTPException(503, '공유 이용 흐름 저장소에 연결할 수 없습니다. 서버 설정과 연결을 확인하세요.') from None
+
+
+@router.post('/events', status_code=202)
+async def publish(request: Request, response: Response):
+    # Guests may emit strictly allowlisted observations, never read other users.
+    # Do not trust proxy/client-supplied account IDs, source labels or source='backend'.
+    if 'application/json' not in request.headers.get('content-type', '').lower():
+        raise HTTPException(415, 'JSON 이용 흐름 메타데이터가 필요합니다.')
+    raw = bytearray()
+    async for chunk in request.stream():
+        raw.extend(chunk)
+        if len(raw) > MAX_BODY:
+            raise HTTPException(413, '이용 흐름 전송 크기를 초과했습니다.')
+    try:
+        batch = clean_batch(json.loads(raw))
+    except (ValueError, TypeError, UnicodeDecodeError):
+        raise HTTPException(422, '이용 흐름 메타데이터 형식이 올바르지 않습니다.') from None
+    if not batch:
+        raise HTTPException(422, '수집 가능한 이용 흐름 이벤트가 없습니다.')
+    address = request.client.host if request.client else 'unknown'
+    # Address is hashed, process/store-internal, and never returned in events.
+    # A reverse proxy/NAT can represent many legitimate users; size + per-source
+    # limits do most of the protection. Keep the coarse address ceiling generous.
+    await invoke(request, 'rate', 'ip:' + hashlib.sha256(address.encode()).hexdigest(), 120000)
+    await invoke(request, 'rate', batch[0]['publisher'], 240)
+    accepted = 0
+    for envelope in batch:
+        accepted += bool(await invoke(request, 'append', envelope))
+    response.headers['Cache-Control'] = 'no-store'
+    return {'accepted': accepted, 'source_id': batch[0]['publisher'], 'scope': service(request).scope, 'available': True}
+
+
+@router.get('/events')
+async def events(request: Request, response: Response, cursor: str | None = Query(None, max_length=40),
+                 limit: int = Query(200, ge=1, le=1000), uid: str = Depends(user)):
+    if cursor:
+        try:
+            cursor_key(cursor)
+        except ValueError:
+            raise HTTPException(422, '이용 흐름 재연결 위치가 올바르지 않습니다.') from None
+    response.headers['Cache-Control'] = 'no-store'
+    return await invoke(request, 'read', cursor, limit)
+
+
+@router.get('/sources')
+async def sources(request: Request, response: Response, limit: int = Query(100, ge=1, le=200),
+                  offset: int = Query(0, ge=0, le=5000), uid: str = Depends(user)):
+    response.headers['Cache-Control'] = 'no-store'
+    return await invoke(request, 'snapshots', offset, limit)
+
+
+@router.get('/status')
+async def status(request: Request, response: Response, uid: str = Depends(user)):
+    response.headers['Cache-Control'] = 'no-store'
+    return await invoke(request, 'status')
