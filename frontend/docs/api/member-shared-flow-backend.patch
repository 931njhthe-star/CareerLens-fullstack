+def _call(row):
+    # Aliases are projected by PostgREST; fallback supports local test fixtures.
+    content = _record(row.get('content'))
+    context = _record(row.get('call_context', content.get('context')))
+    usage = _record(row.get('usage', content.get('usage')))
+    success = row.get('success', content.get('success'))
+    return {'id': _uuid(row.get('id')), 'phase': _choice(context.get('phase'), PHASES),
+            'created_at': _time(row.get('created_at')),
+            'schema': _choice(row.get('call_schema', content.get('schema')), SCHEMAS),
+            'criterion_code': _choice(context.get('criterion_code'), CRITERION_CODES),
+            'model': _token(row.get('call_model', content.get('model'))),
+            'request_sha256': _hash(row.get('request_hash', content.get('request_hash'))),
+            'schema_sha256': _hash(row.get('schema_hash', content.get('schema_hash'))),
+            'prompt_sha256': _hash(row.get('prompt_hash', content.get('prompt_hash'))),
+            'success': success if type(success) is bool else None,
+            'duration_ms': _number(row.get('duration_ms', content.get('duration_ms'))),
+            'input_tokens': _count(usage.get('input_tokens')), 'output_tokens': _count(usage.get('output_tokens'))}
