+@pytest.mark.asyncio
+@pytest.mark.parametrize('fail', [False, True])
+async def test_llm_audit_hashes_exact_instruction_and_response_schema_without_request_changes(fail):
+    class Output(BaseModel):
+        summary: str
+
+    requests, recorded = [], []
+    result = Output(summary='result')
+    response = SimpleNamespace(output_parsed=result, output_text='result', usage=None)
+
+    async def parse(**kwargs):
+        requests.append(kwargs)
+        if fail:
+            raise ValueError('provider failure')
+        return response
+
+    async def audit(record):
+        recorded.append(record)
+
+    llm = object.__new__(LLM)
+    llm.config = SimpleNamespace(openai_api_key=SecretStr('test'), openai_model='test-model')
+    llm.client = SimpleNamespace(responses=SimpleNamespace(parse=parse))
+    llm.limit = asyncio.Semaphore(1)
+    instruction, payload = '정적 지시문', 'PRIVATE INPUT'
+    if fail:
+        with pytest.raises(ValueError):
+            await llm.parse(Output, instruction, payload, audit=audit)
+    else:
+        assert await llm.parse(Output, instruction, payload, audit=audit) is result
+
+    assert len(requests) == 1
+    assert requests[0]['input'] == [
+        {'role': 'system', 'content': instruction}, {'role': 'user', 'content': payload},
+    ]
+    assert requests[0]['text_format'] is Output
+    assert recorded[0]['prompt_hash'] == sha256(instruction.encode('utf-8')).hexdigest()
+    expected_schema = json.dumps(Output.model_json_schema(), ensure_ascii=False, sort_keys=True, separators=(',', ':'))
+    assert recorded[0]['schema_hash'] == sha256(expected_schema.encode('utf-8')).hexdigest()
+    assert recorded[0]['request_hash'] == sha256((instruction + '\0' + payload).encode('utf-8')).hexdigest()
+    assert recorded[0]['success'] is not fail
+    assert payload not in json.dumps(recorded)
