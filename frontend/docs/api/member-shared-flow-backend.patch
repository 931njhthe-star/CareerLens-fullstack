+def envelope(publisher=None, revision=1, node='auth', state='complete'):
+    ident = publisher or str(uuid4())
+    return {'kind': 'event', 'publisher': 'browser:' + ident, 'stream': ident, 'revision': revision,
+            'at': int(time.time() * 1000), 'active': True,
+            'event': {'id': f'event-{revision}', 'node': node, 'kind': 'session', 'state': state,
+                      'source': 'observed', 'sessionMode': 'member', 'at': int(time.time() * 1000)}}
+
+
+@pytest.fixture(params=['memory', 'redis'])
+def store(request):
+    if request.param == 'memory':
+        return MemoryFlowStore()
+    fakeredis = pytest.importorskip('fakeredis')
+    pytest.importorskip('lupa')
+    value = RedisFlowStore('redis://localhost:6379')
+    value.redis = fakeredis.FakeRedis(decode_responses=True)
+    return value
