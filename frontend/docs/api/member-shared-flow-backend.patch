+def _checkpoint_metadata(connection_string, thread_id):
+    """A short, SELECT-only connection; no LangGraph setup/schema creation."""
+    import psycopg
+    from psycopg.rows import dict_row
+    with psycopg.connect(connection_string, autocommit=True, connect_timeout=3,
+                         row_factory=dict_row, prepare_threshold=0,
+                         options='-c default_transaction_read_only=on -c statement_timeout=1500') as conn:
+        row = conn.execute('SELECT count(*) AS count FROM career_lens_checkpoints.checkpoints WHERE thread_id=%s',
+                           (thread_id,)).fetchone()
+        latest = conn.execute("SELECT checkpoint_id, checkpoint->>'ts' AS saved_at FROM career_lens_checkpoints.checkpoints WHERE thread_id=%s ORDER BY checkpoint_id DESC LIMIT 1",
+                              (thread_id,)).fetchone()
+    return {'status': 'available', 'count': _count(row['count']),
+            'latest_id': _uuid(latest['checkpoint_id']) if latest else None,
+            'latest_at': _time(latest['saved_at']) if latest else None}
+
+
+async def _checkpoints(settings, thread_id):
+    if not thread_id:
+        return {'status': 'not_recorded', 'count': None, 'latest_id': None, 'latest_at': None,
+                'reason': '실행에 저장된 그래프 스레드 식별자가 없습니다.'}
+    secret = getattr(settings, 'supabase_db_url', None) if settings is not None else None
+    connection_string = secret.get_secret_value() if hasattr(secret, 'get_secret_value') else ''
+    if not connection_string:
+        return {'status': 'unavailable', 'count': None, 'latest_id': None, 'latest_at': None,
+                'reason': '체크포인트 저장소 연결이 없어 실제 저장 여부를 확인하지 못했습니다.'}
+    try:
+        return await asyncio.wait_for(asyncio.to_thread(_checkpoint_metadata, connection_string, thread_id), timeout=6)
+    except Exception:
+        return {'status': 'unavailable', 'count': None, 'latest_id': None, 'latest_at': None,
+                'reason': '체크포인트 저장소의 메타데이터를 현재 조회할 수 없습니다.'}
