+async def _select(db, table, *, limit, **params):
+    try:
+        rows = await db.select(table, limit=limit + 1, **params)
+        if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
+            raise ValueError('Invalid metadata rows')
+        return {'rows': rows[:limit], 'ok': True, 'truncated': len(rows) > limit}
+    except Exception:
+        # Upstream messages may contain credentials or private database details.
+        return {'rows': [], 'ok': False, 'truncated': False}
+
+
+def _state(query, missing):
+    if not query['ok']:
+        return _availability('unavailable', '저장소의 운영 기록을 현재 조회할 수 없습니다.')
+    if query['truncated']:
+        return _availability('partial', '표시 상한을 넘는 기록이 있어 일부만 표시합니다. 합계는 미확정입니다.', truncated=True)
+    if not query['rows']:
+        return _availability('not_recorded', missing)
+    return _availability('available', '해당 실행에 실제 저장된 기록입니다.')
