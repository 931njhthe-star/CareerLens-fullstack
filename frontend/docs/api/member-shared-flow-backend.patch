@@ -0,0 +1,239 @@
+import copy
+import json
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+from pydantic import SecretStr
+
+import app.application.dashboard as dashboard
+
+
+PRIVATE = 'PRIVATE_RESUME_REPORT_EVIDENCE_AND_UPSTREAM_SECRET'
+TIME = '2026-10-12T00:00:00Z'
+
+
+class FakeDB:
+    def __init__(self, rows):
+        self.rows = rows
+        self.calls = []
+
+    async def select(self, table, **params):
+        self.calls.append((table, params))
+        assert 1 <= params['limit'] <= 501
+        assert params.get('select') and params['select'] != '*'
+        if table == 'evaluation_runs':
+            assert params['id'].startswith('eq.')
+        elif table == 'analysis_reports':
+            assert params['match_result_id'].startswith('eq.')
+        else:
+            assert params['run_id'].startswith('eq.')
+        result = self.rows.get(table, [])
+        if isinstance(result, Exception):
+            raise result
+        return copy.deepcopy(result)
+
+
+def fixture():
+    run, resume, job, match, criterion = (str(uuid4()) for _ in range(5))
+    return run, {
+        'evaluation_runs': [{'id': run, 'user_id': str(uuid4()), 'status': 'partial',
+            'created_at': TIME, 'resume_id': resume, 'job_posting_id': job,
+            'input_fingerprint': 'a' * 64, 'model_name': 'gpt-test',
+            'prompt_version': 'prompt-v7', 'graph_thread_id': str(uuid4()),
+            'failure_reason': PRIVATE}],
+        'evaluation_input_snapshots': [{'id': str(uuid4()), 'input_format': 'markdown',
+            'resume_hash': 'b' * 64, 'job_hash': 'c' * 64, 'snapshot_hash': 'a' * 64,
+            'resume_snapshot': {'original_text': PRIVATE}, 'job_snapshot': {'description': PRIVATE}}],
+        'match_results': [{'id': match, **{key: 0 for key in dashboard.DOMAINS},
+            'overall_score': 0, 'eligibility_status': 'not_met', 'validation_status': 'passed'}],
+        'criterion_results': [{'id': str(uuid4()), 'criterion_id': criterion, 'score': 0,
+            'verdict': 'not_met', 'confidence': 0, 'validation_status': 'passed', 'attempt_count': 1,
+            'evidence': [{'quote': PRIVATE}], 'reasoning_summary': PRIVATE,
+            'evaluation_criteria': {'criterion_code': 'A1', 'name_ko': PRIVATE}}],
+        'node_executions': [{'id': str(uuid4()), 'node_name': 'evaluate_A1',
+            'criterion_id': criterion, 'attempt_number': 1, 'duration_ms': 0,
+            'status': 'completed', 'error_summary': PRIVATE}],
+        'analysis_reports': [{'id': str(uuid4()), 'status': 'completed', 'created_at': TIME,
+            'completed_at': TIME, 'report_text': PRIVATE, 'report_data': {'private': PRIVATE}}],
+        'evaluation_stage_timings': [{'id': 1, 'stage': 'parse_resume', 'criterion_code': None,
+            'attempt_number': 1, 'duration_ms': 0, 'status': 'completed', 'details': {'private': PRIVATE}}],
+        'validation_issues': [],
+    }
+
+
+@pytest.mark.asyncio
+async def test_public_detail_uses_actual_zero_and_never_leaks_private_fields():
+    run, rows = fixture()
+    db = FakeDB(rows)
+    detail = await dashboard.build_run_detail(db, run)
+    payload = json.dumps(detail)
+    assert PRIVATE not in payload
+    assert 'user_id' not in payload and 'original_text' not in payload and 'report_text' not in payload
+    assert detail['scores']['overall_score'] == 0
+    assert detail['scores']['criteria'][0]['evidence_count'] == 1
+    assert detail['stages'][0]['duration_ms'] == 0
+    assert detail['stages'][0]['attempt_number'] == 1
+    assert detail['stages'][0]['criterion_applicability'] == 'not_applicable'
+    assert detail['input']['type'] == 'markdown'
+    assert detail['input']['sha256'] == 'a' * 64
+    assert detail['persistence']['stored'] is True
+    assert detail['persistence']['has_body'] is True
+    assert detail['persistence']['result_schema_compatible'] is True
+    assert detail['persistence']['retrievable'] is None
+    assert detail['validation']['unresolved_issue_count'] == 0
+    assert detail['availability']['validation']['status'] == 'available'
+    assert detail['llm']['call_count'] is None
+    assert detail['tools'] is None and detail['memory']['retrieved_count'] is None
+    assert len(db.calls) == 10
+
+
+@pytest.mark.asyncio
+async def test_missing_metadata_is_not_filled_with_current_config_or_prompt_version():
+    run, rows = fixture()
+    rows['evaluation_input_snapshots'] = []
+    rows['intermediate_artifacts'] = [{'id': str(uuid4()), 'artifact_type': 'criterion_result'}]
+    rows['evaluation_runs'][0].pop('model_name')
+    detail = await dashboard.build_run_detail(FakeDB(rows), run, SimpleNamespace(openai_model='current-new-model'))
+    assert detail['reproduction']['model'] is None
+    assert detail['reproduction']['prompt_version'] == 'prompt-v7'
+    assert detail['reproduction']['schema_version'] is None
+    assert detail['reproduction']['schema_versions'] == []
+    assert detail['input']['type'] is None
+    assert detail['availability']['input_type']['status'] == 'not_recorded'
+    assert detail['llm']['input_tokens'] is None
+    assert detail['llm']['cost'] is None
+
+
+@pytest.mark.asyncio
+async def test_legacy_scores_remain_null_and_reports_are_stored_but_incompatible():
+    run, rows = fixture()
+    rows['criterion_results'][0].update(score=None, verdict='unknown')
+    rows['match_results'][0].update(qualifications=None, eligibility_status='unknown')
+    detail = await dashboard.build_run_detail(FakeDB(rows), run)
+    assert detail['scores']['qualifications'] is None
+    assert detail['scores']['criteria'][0]['score'] is None
+    assert detail['scores']['criteria'][0]['verdict'] == 'unknown'
+    assert detail['persistence']['stored'] is True
+    assert detail['persistence']['result_schema_compatible'] is False
+    assert detail['persistence']['incompatibility_count'] == 3
+
+
+@pytest.mark.asyncio
+async def test_call_hashes_schemas_and_partial_token_usage_are_distinct():
+    run, rows = fixture()
+    rows['intermediate_artifacts'] = [
+        {'id': str(uuid4()), 'artifact_type': 'llm_call', 'schema_version': 'artifact-v2',
+         'content': {'context': {'phase': 'draft', 'criterion_code': 'A1'},
+                     'schema': 'CriterionResult', 'model': 'gpt-test', 'request_hash': 'd' * 64,
+                     'schema_hash': 'e' * 64, 'prompt_hash': 'f' * 64, 'success': True,
+                     'usage': {'input_tokens': 0, 'output_tokens': 12}, 'response_text': PRIVATE}},
+        {'id': str(uuid4()), 'artifact_type': 'llm_call', 'schema_version': 'artifact-v2',
+         'content': {'context': {'phase': 'validation_repair'}, 'schema': 'CriterionResult',
+                     'model': 'gpt-test', 'request_hash': '1' * 64, 'success': False,
+                     'error_type': PRIVATE}},
+    ]
+    detail = await dashboard.build_run_detail(FakeDB(rows), run)
+    assert PRIVATE not in json.dumps(detail)
+    assert detail['llm']['call_count'] == 2
+    assert detail['llm']['input_tokens'] is None and detail['llm']['output_tokens'] is None
+    assert detail['llm']['calls'][0]['input_tokens'] == 0
+    assert detail['llm']['calls'][0]['schema_sha256'] == 'e' * 64
+    assert detail['reproduction']['schema_version'] == 'artifact-v2'
+    assert detail['reproduction']['request_sha256'] is None
+    assert len(detail['reproduction']['request_hashes']) == 2
+
+
+@pytest.mark.asyncio
+async def test_tool_and_checkpoint_counts_require_actual_records(monkeypatch):
+    run, rows = fixture()
+    checkpoint_id = str(uuid4())
+    def read_metadata(connection, thread):
+        assert connection == PRIVATE
+        assert thread == rows['evaluation_runs'][0]['graph_thread_id']
+        return {'status': 'available', 'count': 3, 'latest_id': checkpoint_id, 'latest_at': TIME}
+    monkeypatch.setattr(dashboard, '_checkpoint_metadata', read_metadata)
+    rows['intermediate_artifacts'] = [{'id': str(uuid4()), 'artifact_type': 'tool_call',
+        'schema_version': 'tool-call-v1', 'content': {'name': 'vector_search', 'status': 'completed',
+            'result_count': 0, 'criterion_code': 'A1', 'duration_ms': 8, 'payload': PRIVATE}}]
+    detail = await dashboard.build_run_detail(FakeDB(rows), run, SimpleNamespace(supabase_db_url=SecretStr(PRIVATE)))
+    assert detail['tools'][0]['name'] == 'vector_search'
+    assert detail['tools'][0]['result_count'] == 0
+    assert detail['memory']['retrieved_count'] == 0
+    assert detail['memory']['checkpoint_count'] == 3
+    assert detail['memory']['checkpoint_id'] == checkpoint_id
+    assert PRIVATE not in json.dumps(detail)
+
+
+@pytest.mark.asyncio
+async def test_metadata_failure_is_sanitized_and_does_not_erase_other_sections(monkeypatch):
+    run, rows = fixture()
+    rows['validation_issues'] = RuntimeError(PRIVATE)
+    def fail(*args):
+        raise RuntimeError(PRIVATE)
+    monkeypatch.setattr(dashboard, '_checkpoint_metadata', fail)
+    detail = await dashboard.build_run_detail(FakeDB(rows), run, SimpleNamespace(supabase_db_url=SecretStr(PRIVATE)))
+    assert detail['availability']['validation']['status'] == 'unavailable'
+    assert detail['validation']['unresolved_issue_count'] is None
+    assert detail['memory']['checkpoints']['status'] == 'unavailable'
+    assert detail['scores']['overall_score'] == 0
+    assert PRIVATE not in json.dumps(detail)
+
+
+@pytest.mark.asyncio
+async def test_capped_history_does_not_claim_complete_call_totals():
+    run, rows = fixture()
+    rows['intermediate_artifacts'] = [{'id': str(uuid4()), 'artifact_type': 'llm_call',
+        'content': {'usage': {'input_tokens': 1, 'output_tokens': 1}}} for _ in range(501)]
+    detail = await dashboard.build_run_detail(FakeDB(rows), run)
+    assert len(detail['llm']['calls']) == 500
