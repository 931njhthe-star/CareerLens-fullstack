@@ -0,0 +1,46 @@
+import asyncio
+import inspect
+import logging
+from datetime import datetime, timezone
+from time import perf_counter
+
+
+logger = logging.getLogger(__name__)
+
+
+async def observe_tool(name, operation, audit=None, *, criterion_code=None, model=None):
+    """Observe a real tool operation without retaining its input or result contents."""
+    started_at = datetime.now(timezone.utc).isoformat()
+    started = perf_counter()
+    status, result_count, error_type = 'completed', None, None
+    try:
+        result = operation()
+        if inspect.isawaitable(result):
+            result = await result
+        if isinstance(result, (list, tuple)):
+            result_count = len(result)
+        return result
+    except asyncio.CancelledError:
+        status = 'cancelled'
+        raise
+    except Exception as exc:
+        status, error_type = 'failed', type(exc).__name__
+        raise
+    finally:
+        if audit:
+            record = {
+                'name': name, 'criterion_code': criterion_code, 'status': status,
+                'started_at': started_at,
+                'duration_ms': round((perf_counter() - started) * 1000),
+                'result_count': result_count,
+            }
+            if model:
+                record['model'] = model
+            if error_type:
+                record['error_type'] = error_type
+            try:
+                await audit(record)
+            except Exception:
+                # Optional observability must not change the operation's result or error.
+                # Do not log exception messages: upstream errors may contain private data.
+                logger.warning('Optional tool telemetry could not be stored')
diff --git a/docs/architecture/shared-flow.md b/docs/architecture/shared-flow.md
new file mode 100644
index 0000000000000000000000000000000000000000..96aec9d07a5fcdcb1385c5c8df7ea824616c0c39
--- /dev/null
+++ b/docs/architecture/shared-flow.md
@@ -0,0 +1,79 @@
+# Shared operation flow
+
+Dashboard summary/detail and `/api/v1/flow/{events,sources,status}` reads require a
+valid member access token. No administrator list is consulted. Responses contain
+allowlisted operational metadata, never account IDs, email, documents, report text,
+request URLs, model prompts, credentials or raw errors. Existing personal-resource
+ownership checks are unchanged.
+
+Set `APP_ENV=production` and `CAREERLENS_FLOW_REDIS_URL` to the same private Redis
+instance in **all API, evaluation worker and frontend guest-engine processes**.
+Install `requirements.lock.txt` (includes Redis 6.4). Redis URLs are server-only
+secrets. Do not put them in frontend JS. Production without shared Redis fails
+flow reads/writes with a controlled 503; it never falls back to isolated memory.
+Development without Redis explicitly reports `scope: process`, which cannot
+aggregate other processes. Use Redis locally to exercise the deployment topology.
+
+This adds no Supabase table/migration. Existing application migrations and
+checkpoints must already be provisioned for normal evaluations. Redis should be
+private, authenticated/TLS as appropriate, persistent and monitored. AOF preserves
+retained flow metadata across Redis restarts; losing/evicting the Redis database
+causes an explicit cursor gap and observer snapshot reload, not reconstructed data.
+
+## Transport
+
+- `POST /api/v1/flow/events`: `{publisher: UUID, stream: UUID, client_dropped?: int,
+  batch: [envelope]}`. Up to 25 envelopes / 128 KiB. Guest publishing is permitted,
+  while reading is member-only. Client observations are always `source: observed`;
+  client attempts to claim server authority or supply extra fields are discarded.
+  Response: `{accepted, source_id, scope, available}`. Duplicate/older revisions
+  are not stored twice. Request budgets: 240 batches/minute/source and a coarse
+  120,000/minute/address limit, accommodating shared proxies/NAT. Deploy ingress
+  request/connection limits as well; random source IDs are not authentication.
+- Envelope kinds: `event`, `snapshot`, `active`, `disconnected`. Event node, kind,
+  state, method and criterion are fixed allowlists. Numeric progress, duration and
+  timestamp are bounded. No arbitrary label/message field is accepted.
+- `GET /sources?limit=100&offset=0`: `{sources,total,has_more,cursor,scope,available}`.
+  Each source snapshot and its high-water cursor are read atomically. Observe from
+  the first page cursor while loading subsequent pages to catch intervening events.
+- `GET /events?cursor=<redis-id>&limit=200`: `{events:[{id,envelope}],cursor,
+  has_more,gap,scope,available}`. Drain `has_more`, then poll about once per second.
+  On gap, reload snapshots; do not replay old records as new animation.
+- `GET /status`: scope/availability/retention limits plus worker heartbeat status.
+  Worker heartbeats every 5 seconds expire from health after 30 seconds. In shared
+  mode a new member evaluation is rejected before enqueueing when no live worker
+  is observed **or Redis health cannot be read**. This explicit admission
+  dependency avoids accepting work into an unverified queue. Recovery of an
+  already accepted idempotent request still returns its existing run. Worker
+  presence is not a guarantee of DB/model connectivity.
+
+API, worker and guest engine may use `emit_server_event(run_id,node,state,...)`.
+This helper accepts only fixed metadata and cannot interrupt real analysis on an
+observation failure. The source namespace (`worker:UUID` / `guest:UUID`) is assigned
+by the server; browser clients cannot publish into it. `link_run_source` links a
+run to the random browser publisher from `X-CareerLens-Flow-Publisher`, providing
+anonymous correlation only, never granting report ownership/access. A forged
+browser observation/correlation is untrusted and must not be used as an audit log
+or proof of a real server action.
+
+## Bounds and verification
+
+Retention is at most 24 hours, 50,000 global events, 5,000 source snapshots, and
+100 recent events per source. Source states remain separate. Limits intentionally
+prevent unbounded memory; this is recent live observation, not durable accounting
+of every request forever. Client queue loss is carried in `client_dropped`, and
+cursor gaps disclose records no longer retained. Analysis scoring/DB values are
+not derived from these records.
+
+Server emission is best-effort, not a durable outbox. A Redis outage can lose
+worker/guest events, including terminal events, and reconnecting does not
+guarantee recovery of those missing events from the report database. Existing
+analyses continue; the flow view must disclose connection/retention limitations
+and must not claim that every request during an outage was recorded.
+
+`tests/test_flow.py` covers parallel 32-source publishing, event isolation,
+duplicate suppression, reconnect/cursor gaps, Redis Lua atomic worker updates,
+member-only reads, sanitized guest publishing, bounded retention, worker health
+and transient DB-claim recovery. Redis protocol tests use optional
+`fakeredis[lua]` and are synthetic; they are not deployed load/capacity results.
+Install `requirements-dev.txt` in the test environment to run that coverage.
