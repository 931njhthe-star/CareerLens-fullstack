+def test_multiple_users_publish_without_overwriting_and_reconnect(store):
+    publishers = [str(uuid4()) for _ in range(32)]
+    def publish(ident):
+        for revision in range(1, 21):
+            store.append(envelope(ident, revision))
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        list(pool.map(publish, publishers))
+    sources = store.snapshots(limit=100)
+    assert sources['total'] == 32
+    assert all(row['revision'] == 20 and len(row['events']) == 20 for row in sources['sources'])
+    cursor = None
+    identifiers = []
+    while True:
+        page = store.read(cursor, 73)
+        identifiers += [row['id'] for row in page['events']]
+        cursor = page['cursor']
+        if not page['has_more']:
+            break
+    assert len(identifiers) == len(set(identifiers)) == 640
+    assert store.read(cursor)['events'] == []
+    store.append(envelope(publishers[0], 21))
+    assert len(store.read(cursor)['events']) == 1
+
