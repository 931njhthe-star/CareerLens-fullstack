+    assert link_run_source(run, first['stream'], store=store)
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        results = list(pool.map(lambda node: emit_server_event(run, node, 'running', progress=30, store=store),
+                                ['domain_a', 'domain_b', 'domain_c', 'domain_d']))
+    assert all(results)
+    source = next(row for row in store.snapshots()['sources'] if row['publisher'].startswith('worker:'))
+    assert source['revision'] == 4
+    assert source['related_publisher'] == first['publisher']
+    assert len(source['states']) == 4
+    emit_server_event(run, 'analysis', 'cancelled', store=store)
+    source = next(row for row in store.snapshots()['sources'] if row['publisher'].startswith('worker:'))
+    assert [row['node'] for row in source['states']] == ['analysis']
+    assert not emit_server_event(run, 'analysis', 'running', progress=95, store=store)
+    assert not emit_server_event(run, 'guest_store', 'complete', store=store)
+    source = next(row for row in store.snapshots()['sources'] if row['publisher'].startswith('worker:'))
+    assert source['states'][0]['state'] == 'cancelled'
