+"""Bounded operational metadata, shared by API, workers and guest execution.
+
+No documents, account IDs, URLs, free-form labels or error strings enter this store.
+Redis is required in production; memory is an explicitly process-local dev fallback.
+"""
+import asyncio
+import copy
+import hashlib
+import json
+import math
+import re
+import threading
+import time
+from collections import OrderedDict, deque
+from functools import lru_cache
+from uuid import UUID, uuid4
+
+NODES = frozenset(('visit auth resume role posting api_auth api_resume api_jobs api_evaluation '
+    'api_report queue analysis report signup logout session cancel history dashboard evaluate '
+    'api_signup api_session api_cancel api_dashboard api_convert input_check local_data notice '
+    'storage_ack parse_resume parse_job indexing domain_a domain_b domain_c domain_d validation '
+    'scoring database api_guest_service api_guest_analysis api_guest_claim api_guest_reports '
+    'guest_store report_lock guest_claim result_delivery guest_cleanup').split())
+STATES = frozenset('pending running complete failed cancelled partial blocked waiting expired cleared empty'.split())
+KINDS = frozenset('action request navigation progress session'.split())
+INTERNAL = frozenset('queue analysis parse_resume parse_job indexing domain_a domain_b domain_c domain_d validation scoring database guest_store'.split())
+RETENTION_SECONDS = 86400
+MAX_SOURCES = 5000
+MAX_EVENTS = 50000
+PREFIX = 'careerlens:flow:v1:'
+
+
+class FlowUnavailable(Exception):
+    pass
+
+
+class FlowRateLimited(Exception):
+    pass
+
+
+def number(value, maximum):
+    return value if isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= maximum and math.isfinite(value) else None
+
+
+def identifier(value):
+    try:
+        return str(UUID(str(value)))
+    except (ValueError, TypeError, AttributeError):
+        raise ValueError('Invalid flow identifier') from None
+
+
+def clean_event(raw, *, server=False):
+    if not isinstance(raw, dict) or raw.get('node') not in NODES or raw.get('state') not in STATES or raw.get('kind') not in KINDS:
+        return None
+    if raw.get('source') == 'demo' or raw.get('sessionMode') == 'demo':
+        return None
+    ident = raw.get('id')
+    if not isinstance(ident, str) or not re.fullmatch(r'(?:event|request|server)-[0-9]{1,16}', ident):
+        return None
+    event = {key: raw[key] for key in ('id', 'node', 'kind', 'state')}
+    event.update(source='backend' if server else 'observed', at=number(raw.get('at'), 10**14) or int(time.time() * 1000),
+                 durationMs=number(raw.get('durationMs'), 86400000), progress=number(raw.get('progress'), 100))
+    if raw.get('method') in ('GET', 'POST', 'PUT', 'PATCH', 'DELETE'):
+        event['method'] = raw['method']
+    if raw.get('sessionMode') in ('guest', 'member'):
+        event['sessionMode'] = raw['sessionMode']
+    if raw.get('execution') == 'guest':
+        event['execution'] = 'guest'
+    criterion = raw.get('criterion')
+    if isinstance(criterion, str) and re.fullmatch('[A-D][1-3]', criterion) and raw['node'] == 'domain_' + criterion[0].lower():
+        event['criterion'] = criterion
+    return event
+
+
+def clean_batch(body):
+    if not isinstance(body, dict):
+        raise ValueError('Invalid flow batch')
+    stream, publisher = identifier(body.get('stream')), 'browser:' + identifier(body.get('publisher'))
+    batch = body.get('batch')
+    if not isinstance(batch, list) or not 1 <= len(batch) <= 25:
+        raise ValueError('Invalid flow batch')
+    result = []
+    for raw in batch:
+        if not isinstance(raw, dict) or raw.get('kind') not in ('event', 'snapshot', 'active', 'disconnected'):
+            continue
+        if isinstance(raw.get('session'), dict) and raw['session'].get('mode') == 'demo':
+            continue
+        revision = raw.get('revision')
+        if not isinstance(revision, int) or isinstance(revision, bool) or not 0 < revision < 2**53:
+            continue
+        envelope = {'kind': raw['kind'], 'publisher': publisher, 'stream': stream, 'revision': revision,
+                    'at': int(time.time() * 1000), 'active': raw.get('active') is True,
+                    'client_dropped': int(number(body.get('client_dropped'), 10**9) or 0)}
+        if raw['kind'] == 'event':
+            event = clean_event(raw.get('event'))
+            if event is None:
+                continue
+            envelope['event'] = event
+        if raw['kind'] == 'snapshot':
+            for field in ('events', 'states'):
+                values = raw.get(field, [])
+                envelope[field] = [event for row in values[-100:] if (event := clean_event(row))] if isinstance(values, list) else []
+            mode = raw.get('session', {}).get('mode') if isinstance(raw.get('session'), dict) else None
+            envelope['session'] = {'mode': mode if mode in ('member', 'guest') else 'guest'}
+        result.append(envelope)
+    return result
+
+
+def update_snapshot(previous, envelope):
+    snap = copy.deepcopy(previous or {'events': [], 'states': [], 'session': {'mode': 'guest'}})
+    snap.update({key: envelope[key] for key in ('publisher', 'stream', 'revision', 'at')})
+    snap['kind'] = 'snapshot'
+    snap['connected'] = envelope['kind'] != 'disconnected'
+    if 'client_dropped' in envelope:
+        snap['client_dropped'] = envelope['client_dropped']
+    if envelope.get('related_publisher'):
+        snap['related_publisher'] = envelope['related_publisher']
+    if envelope['kind'] == 'snapshot':
+        snap.update({key: envelope[key] for key in ('events', 'states', 'session')})
+    if envelope['kind'] == 'event':
+        event = envelope['event']
+        snap['events'] = [row for row in snap['events'] if row['id'] != event['id']][-99:] + [event]
+        snap['states'] = [row for row in snap['states'] if row['node'] != event['node']] + [event]
+        if event.get('sessionMode'):
+            snap['session'] = {'mode': event['sessionMode']}
+        if event['node'] == 'analysis' and event['state'] in ('complete', 'partial', 'failed', 'cancelled'):
+            snap['states'] = [row for row in snap['states'] if row['node'] == 'analysis' or row['node'] not in INTERNAL or row['state'] not in ('pending', 'running')]
+    return snap
+
+
+class MemoryFlowStore:
+    scope = 'process'
+
+    def __init__(self, *, maximum=MAX_EVENTS, source_limit=MAX_SOURCES, now=time.time):
+        self.lock, self.now = threading.RLock(), now
+        self.events, self.sources, self.rates, self.links = deque(maxlen=maximum), {}, OrderedDict(), OrderedDict()
+        self.source_limit, self.sequence = source_limit, 0
+        self.epoch = int(now() * 1000)
+
+    def _prune(self):
+        cutoff = self.now() * 1000 - RETENTION_SECONDS * 1000
+        while self.events and self.events[0]['envelope']['at'] < cutoff:
+            self.events.popleft()
+        self.sources = {key: row for key, row in self.sources.items() if row['at'] >= cutoff}
+
+    def rate(self, key, limit):
+        with self.lock:
+            window = int(self.now() // 60)
+            count, old = self.rates.get(key, (0, window))
+            count = count + 1 if window == old else 1
+            self.rates[key] = (count, window)
+            self.rates.move_to_end(key)
+            while len(self.rates) > 10000:
+                self.rates.popitem(last=False)
+            if count > limit:
+                raise FlowRateLimited()
+
+    def append(self, envelope, *, server=False):
+        with self.lock:
+            self._prune()
+            previous = self.sources.get(envelope['publisher'])
+            if server:
+                states = {row['node']: row for row in (previous or {}).get('states', [])}
+                analysis = states.get('analysis', {})
+                terminal = analysis.get('state') in ('complete', 'partial', 'failed', 'cancelled')
+                event = envelope['event']
+                # A committed cancellation/deletion wins over a delayed completion
+                # callback. Repeated finals cannot replay lights on an idle run.
+                if terminal and not (event['node'] == 'analysis' and event['state'] == 'cancelled' and analysis['state'] != 'cancelled'):
+                    return False
+                if event['node'] == 'queue' and event['state'] == 'pending' and ('queue' in states or analysis):
+                    return False
+                envelope = copy.deepcopy(envelope)
+                if event['node'] == 'analysis' and event['state'] == 'running' and isinstance(event.get('progress'), (int, float)) and isinstance(analysis.get('progress'), (int, float)):
+                    envelope['event']['progress'] = max(event['progress'], analysis['progress'])
+                envelope['revision'] = (previous or {}).get('revision', 0) + 1
+                envelope['event']['id'] = 'server-' + str(envelope['revision'])
+            elif previous and envelope['revision'] <= previous['revision']:
+                return False
+            self.sequence += 1
+            ident = f'{self.epoch}-{self.sequence}'
+            self.events.append({'id': ident, 'envelope': copy.deepcopy(envelope)})
+            self.sources[envelope['publisher']] = update_snapshot(previous, envelope)
+            if len(self.sources) > self.source_limit:
+                oldest = min(self.sources, key=lambda key: self.sources[key]['at'])
+                del self.sources[oldest]
+            return True
+
+    def read(self, cursor=None, limit=200):
+        with self.lock:
+            self._prune()
+            rows = list(self.events)
+            keys = [row['id'] for row in rows]
+            gap = bool(cursor and cursor not in ('0-0', f'{self.epoch}-0') and
+                       ((rows and (cursor_key(cursor) < cursor_key(keys[0]) or cursor_key(cursor) > cursor_key(keys[-1])))
+                        or (not rows and cursor != f'{self.epoch}-{self.sequence}')))
+            newer = [row for row in rows if not cursor or gap or cursor_key(row['id']) > cursor_key(cursor)]
+            page = newer[:limit]
+            return {'events': copy.deepcopy(page), 'cursor': page[-1]['id'] if page else (cursor or f'{self.epoch}-{self.sequence}'),
+                    'has_more': len(newer) > limit, 'gap': gap, 'scope': self.scope, 'available': True}
+
+    def snapshots(self, offset=0, limit=100):
+        with self.lock:
+            self._prune()
+            # Activity timestamps change while paging. Stable publisher ordering
+            # prevents a busy older source jumping over the observer's offset.
+            rows = sorted(self.sources.values(), key=lambda row: row['publisher'])
+            return {'sources': copy.deepcopy(rows[offset:offset + limit]), 'total': len(rows), 'has_more': len(rows) > offset + limit,
+                    'cursor': f'{self.epoch}-{self.sequence}', 'scope': self.scope, 'available': True}
+
+    def status(self):
+        return {'available': True, 'scope': self.scope, 'retention_seconds': RETENTION_SECONDS, 'max_events': MAX_EVENTS, 'max_sources': MAX_SOURCES,
+                'worker': {'known': False, 'available': None, 'count': None}}
+
+    def worker_heartbeat(self, worker):
+        # A process-local store cannot attest a separate worker process's health.
+        return None
+
+    def link(self, source, publisher):
+        with self.lock:
+            self.links[source] = (publisher, self.now())
+            self.links.move_to_end(source)
+            while len(self.links) > self.source_limit:
+                self.links.popitem(last=False)
+
+    def related(self, source):
+        with self.lock:
+            row = self.links.get(source)
+            return row[0] if row and self.now() - row[1] < RETENTION_SECONDS else None
+
+
+def cursor_key(value):
+    if not isinstance(value, str) or not re.fullmatch(r'[0-9]{1,16}-[0-9]{1,16}', value):
+        raise ValueError('Invalid flow cursor')
+    return tuple(map(int, value.split('-')))
+
+
+# All source state updates and the global cursor commit together. Redis clients in
+# separate API/worker processes cannot overwrite concurrent domain progress.
+APPEND_LUA = r'''
+local env = cjson.decode(ARGV[1])
+local old = redis.call('HGET', KEYS[2], env.publisher)
+local prev = old and cjson.decode(old) or {events={}, states={}, session={mode='guest'}, revision=0}
+if ARGV[2] == '1' then
+ local analysis=nil; local queue=nil; for _,e in ipairs(prev.states) do if e.node=='analysis' then analysis=e elseif e.node=='queue' then queue=e end end
+ local terminal=analysis and (analysis.state=='complete' or analysis.state=='partial' or analysis.state=='failed' or analysis.state=='cancelled')
+ local cancel=env.event.node=='analysis' and env.event.state=='cancelled'
+ if terminal and not (cancel and analysis.state~='cancelled') then return 0 end
+ if env.event.node=='queue' and env.event.state=='pending' and (queue or analysis) then return 0 end
+ if env.event.node=='analysis' and env.event.state=='running' and analysis and type(analysis.progress)=='number' and type(env.event.progress)=='number' then env.event.progress=math.max(env.event.progress,analysis.progress) end
+ env.revision=prev.revision+1; env.event.id='server-'..env.revision
+elseif env.revision <= prev.revision then return 0 end
+local snap={kind='snapshot',publisher=env.publisher,stream=env.stream,revision=env.revision,at=env.at,connected=env.kind~='disconnected',events=prev.events,states=prev.states,session=prev.session}
+snap.related_publisher=env.related_publisher or prev.related_publisher
+snap.client_dropped=env.client_dropped or prev.client_dropped or 0
+if env.kind=='snapshot' then snap.events=env.events; snap.states=env.states; snap.session=env.session end
+if env.kind=='event' then
+ local es={}; for _,e in ipairs(snap.events) do if e.id~=env.event.id then table.insert(es,e) end end
+ table.insert(es,env.event); while #es>100 do table.remove(es,1) end; snap.events=es
+ local st={}; for _,e in ipairs(snap.states) do if e.node~=env.event.node then table.insert(st,e) end end
+ table.insert(st,env.event); snap.states=st
+ if env.event.sessionMode then snap.session={mode=env.event.sessionMode} end
+ if env.event.node=='analysis' and (env.event.state=='complete' or env.event.state=='partial' or env.event.state=='failed' or env.event.state=='cancelled') then
+  local internal={queue=true,parse_resume=true,parse_job=true,indexing=true,domain_a=true,domain_b=true,domain_c=true,domain_d=true,validation=true,scoring=true,database=true,guest_store=true}
+  local clean={}; for _,e in ipairs(snap.states) do if not internal[e.node] or (e.state~='pending' and e.state~='running') then table.insert(clean,e) end end; snap.states=clean
+ end
+end
+redis.call('HSET',KEYS[2],env.publisher,cjson.encode(snap)); redis.call('ZADD',KEYS[3],env.at,env.publisher)
+local stale=redis.call('ZRANGEBYSCORE',KEYS[3],'-inf',ARGV[3]); for _,k in ipairs(stale) do redis.call('HDEL',KEYS[2],k); redis.call('ZREM',KEYS[3],k) end
+local over=redis.call('ZCARD',KEYS[3])-tonumber(ARGV[4]); if over>0 then local ks=redis.call('ZRANGE',KEYS[3],0,over-1); for _,k in ipairs(ks) do redis.call('HDEL',KEYS[2],k); redis.call('ZREM',KEYS[3],k) end end
+redis.call('XADD',KEYS[1],'MAXLEN',ARGV[5],'*','envelope',cjson.encode(env)); redis.call('XTRIM',KEYS[1],'MINID',ARGV[3]..'-0')
+for _,key in ipairs(KEYS) do redis.call('EXPIRE',key,ARGV[6]) end
+return 1
+'''
+SOURCES_LUA = r'''
+local latest=redis.call('XREVRANGE',KEYS[1],'+','-','COUNT',1)
+local ids=redis.call('ZRANGEBYSCORE',KEYS[3],ARGV[3],'+inf'); table.sort(ids); local rows={}
+for i=tonumber(ARGV[1])+1,math.min(#ids,tonumber(ARGV[1])+tonumber(ARGV[2])) do local value=redis.call('HGET',KEYS[2],ids[i]); if value then table.insert(rows,value) end end
+return cjson.encode({rows=rows,total=redis.call('ZCOUNT',KEYS[3],ARGV[3],'+inf'),cursor=(#latest>0 and latest[1][1] or '0-0')})
+'''
+READ_LUA = r'''
+local cursor=ARGV[1]; local limit=tonumber(ARGV[2]); local cutoff=ARGV[3]
+local first=redis.call('XRANGE',KEYS[1],cutoff,'+','COUNT',1)
+local last=redis.call('XREVRANGE',KEYS[1],'+','-','COUNT',1)
+local function before(a,b)
+ local am,as=string.match(a,'^(%d+)%-(%d+)$'); local bm,bs=string.match(b,'^(%d+)%-(%d+)$')
+ if tonumber(am)==tonumber(bm) then return tonumber(as)<tonumber(bs) end
+ return tonumber(am)<tonumber(bm)
+end
+local gap=cursor~='' and cursor~='0-0' and (#first==0 or before(cursor,first[1][1]) or before(last[1][1],cursor))
+local minimum=cutoff; if cursor~='' and not gap then minimum='('..cursor end
+local found=redis.call('XRANGE',KEYS[1],minimum,'+','COUNT',limit+1); local rows={}
+for i=1,math.min(#found,limit) do table.insert(rows,{id=found[i][1],envelope=found[i][2][2]}) end
+local nextcursor=(#rows>0 and rows[#rows].id or (#last>0 and last[1][1] or '0-0'))
+return cjson.encode({rows=rows,cursor=nextcursor,gap=gap,has_more=#found>limit})
+'''
+
+
+class RedisFlowStore:
+    scope = 'shared'
+
+    def __init__(self, url):
+        import redis
+        from redis.backoff import NoBackoff
+        from redis.retry import Retry
+        self.redis = redis.Redis.from_url(url, decode_responses=True, socket_timeout=1, socket_connect_timeout=1,
+                                         retry_on_timeout=False, retry=Retry(NoBackoff(), 0))
+        self.keys = [PREFIX + item for item in ('events', 'sources', 'active')]
+
+    def rate(self, key, limit):
+        name = PREFIX + 'rate:' + hashlib.sha256(key.encode()).hexdigest() + ':' + str(int(time.time() // 60))
+        script = "local n=redis.call('INCR',KEYS[1]); if n==1 then redis.call('EXPIRE',KEYS[1],120) end; return n"
+        if self.redis.eval(script, 1, name) > limit:
+            raise FlowRateLimited()
+
+    def append(self, envelope, *, server=False):
+        cutoff = int(time.time() * 1000) - RETENTION_SECONDS * 1000
+        return bool(self.redis.eval(APPEND_LUA, len(self.keys), *self.keys, json.dumps(envelope), int(server), cutoff, MAX_SOURCES, MAX_EVENTS, RETENTION_SECONDS))
+
+    def read(self, cursor=None, limit=200):
+        if cursor:
+            cursor_key(cursor)
+        cutoff = str(int(time.time() * 1000) - RETENTION_SECONDS * 1000) + '-0'
+        value = json.loads(self.redis.eval(READ_LUA, 1, self.keys[0], cursor or '', limit, cutoff))
+        return {'events': [{'id': row['id'], 'envelope': decode_envelope(row['envelope'])} for row in value['rows']] if value['rows'] else [],
+                'cursor': value['cursor'], 'has_more': value['has_more'], 'gap': value['gap'], 'scope': self.scope, 'available': True}
+
+    def snapshots(self, offset=0, limit=100):
+        value = json.loads(self.redis.eval(SOURCES_LUA, len(self.keys), *self.keys, offset, limit, int(time.time() * 1000) - RETENTION_SECONDS * 1000))
+        rows = [decode_envelope(row) for row in value['rows']] if value['rows'] else []
+        return {'sources': rows, 'total': value['total'], 'has_more': value['total'] > offset + limit,
+                'cursor': value['cursor'], 'scope': self.scope, 'available': True}
+
+    def status(self):
+        self.redis.ping()
+        count = self.redis.zcount(PREFIX + 'workers', time.time() - 30, '+inf')
+        return {'available': True, 'scope': self.scope, 'retention_seconds': RETENTION_SECONDS, 'max_events': MAX_EVENTS, 'max_sources': MAX_SOURCES,
+                'worker': {'known': True, 'available': count > 0, 'count': count, 'max_age_seconds': 30}}
+
+    def worker_heartbeat(self, worker):
+        key = PREFIX + 'workers'
+        with self.redis.pipeline(transaction=True) as pipe:
+            pipe.zadd(key, {identifier(worker): time.time()})
+            pipe.zremrangebyscore(key, '-inf', time.time() - 30)
+            pipe.expire(key, 60)
+            pipe.execute()
+
+    def link(self, source, publisher):
+        script = """redis.call('HSET',KEYS[1],ARGV[1],ARGV[2]); redis.call('ZADD',KEYS[2],ARGV[3],ARGV[1]);
+        local old=redis.call('ZRANGEBYSCORE',KEYS[2],'-inf',ARGV[4]); for _,k in ipairs(old) do redis.call('HDEL',KEYS[1],k); redis.call('ZREM',KEYS[2],k) end;
+        local n=redis.call('ZCARD',KEYS[2])-tonumber(ARGV[5]); if n>0 then local keys=redis.call('ZRANGE',KEYS[2],0,n-1); for _,k in ipairs(keys) do redis.call('HDEL',KEYS[1],k); redis.call('ZREM',KEYS[2],k) end end;
+        redis.call('EXPIRE',KEYS[1],ARGV[6]); redis.call('EXPIRE',KEYS[2],ARGV[6]); return 1"""
+        self.redis.eval(script, 2, PREFIX + 'links', PREFIX + 'link-times', source, publisher, int(time.time()), int(time.time()) - RETENTION_SECONDS, MAX_SOURCES, RETENTION_SECONDS)
+
+    def related(self, source):
+        return self.redis.hget(PREFIX + 'links', source)
+
+
+def decode_envelope(value):
+    row = json.loads(value)
+    # Redis Lua encodes empty tables as objects; wire lists remain arrays.
+    if row.get('kind') == 'snapshot':
+        for field in ('events', 'states'):
+            if not row.get(field):
+                row[field] = []
+    return row
+
+
+class UnavailableFlowStore:
+    scope = 'unavailable'
+
+    def __getattr__(self, name):
+        def unavailable(*args, **kwargs):
+            raise FlowUnavailable()
+        return unavailable
+
+
+@lru_cache(maxsize=4)
+def _store(url, production):
+    if url:
+        try:
+            return RedisFlowStore(url)
+        except Exception:
+            return UnavailableFlowStore()
+    return UnavailableFlowStore() if production else MemoryFlowStore()
+
+
+def flow_store(config=None):
+    if config is None:
+        from app.core.config import settings
+        config = settings()
+    value = getattr(config, 'careerlens_flow_redis_url', '')
+    url = value.get_secret_value() if hasattr(value, 'get_secret_value') else str(value or '')
+    return _store(url, getattr(config, 'app_env', 'development').lower() not in ('development', 'test', 'local'))
+
+
+def emit_server_event(run_id, node, state, *, progress=None, execution='member', criterion=None, store=None):
+    """Best effort observation never fails a real analysis or exposes its contents."""
+    target = None
+    try:
+        stream = identifier(run_id)
+        at = int(time.time() * 1000)
+        event = clean_event({'id': 'server-1', 'node': node, 'state': state, 'kind': 'progress', 'at': at,
+                            'progress': progress, 'execution': execution, 'criterion': criterion,
+                            'sessionMode': 'guest' if execution == 'guest' else 'member'}, server=True)
+        if event is None:
+            return False
+        target = store or flow_store()
+        if target.__dict__.get('_emit_retry_after', 0) > time.monotonic():
+            return False
+        envelope = {'kind': 'event', 'publisher': ('guest:' if execution == 'guest' else 'worker:') + stream,
+                    'stream': stream, 'revision': 1, 'at': at, 'active': False, 'event': event}
+        related = target.related(envelope['publisher'])
+        if related:
+            envelope['related_publisher'] = related
+        return target.append(envelope, server=True)
+    except Exception:
+        if target is not None:
+            target._emit_retry_after = time.monotonic() + 10
+        return False
+
+
+def link_run_source(run_id, publisher, *, execution='member', store=None):
+    """Anonymous request correlation only; never an authorization/ownership grant."""
+    try:
+        source = ('guest:' if execution == 'guest' else 'worker:') + identifier(run_id)
+        browser = 'browser:' + identifier(publisher)
+        (store or flow_store()).link(source, browser)
+        return True
+    except Exception:
+        return False
+
+
+async def observe_progress(db, run_id, stage, message, percent, status):
+    target = getattr(db, 'flow_store', None)
+    if target is None:
+        return
+    node = {'queued': 'queue', 'parsing': 'analysis', 'indexing': 'indexing', 'evaluation': 'analysis',
+            'criterion': 'analysis', 'validation': 'validation', 'completed': 'analysis', 'cancelled': 'analysis'}.get(stage)
+    if node is None:
+        return
+    state = {'completed': 'complete', 'cancelled': 'cancelled', 'failed': 'failed'}.get(status, 'running')
+    criterion = None
+    if stage == 'criterion' and isinstance(message, str) and re.match(r'^[A-D][1-3] · ', message):
+        criterion = message[:2]
+        node = 'domain_' + criterion[0].lower()
+    fixed = {
+        '이력서 문서 구조화 시작': ('parse_resume', 'running'), '이력서 문서 구조화 완료': ('parse_resume', 'complete'),
+        '채용공고 구조화 완료': ('parse_job', 'complete'), '이력서 근거 검색 준비 완료': ('indexing', 'complete'),
+        '최종 점수 계산 시작': ('scoring', 'running'), '최종 점수 계산 완료': ('scoring', 'complete'),
+        '점수 계산 및 Markdown 보고서 생성 시작': ('database', 'running'), '최종 Markdown 보고서 저장 완료': ('database', 'complete'),
+    }
+    if isinstance(message, str) and message in fixed:
+        node, state = fixed[message]
+    await asyncio.to_thread(emit_server_event, run_id, node, state, progress=percent, criterion=criterion, store=target)
+    if node != 'analysis' and stage not in ('completed', 'cancelled'):
+        await asyncio.to_thread(emit_server_event, run_id, 'analysis', 'running', progress=percent, store=target)
