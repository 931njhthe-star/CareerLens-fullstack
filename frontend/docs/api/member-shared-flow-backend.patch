+"""Bounded, read-only operational metadata for the member dashboard.
+
+Never return stored document, report, evidence, issue-description or model-response
+text. Every response below is constructed from an explicit public field allowlist.
+"""
+import asyncio
+from datetime import datetime
+import math
+import re
+from uuid import UUID
+
+RUN_STATES = {'queued', 'running', 'completed', 'partial', 'failed', 'cancelled', 'skipped'}
+PHASES = {'document_parse', 'draft', 'evidence_review', 'independent_evaluation',
+          'disagreement_recheck', 'validation_repair', 'global_critic'}
+SCHEMAS = {'ParsedResume', 'ParsedJob', 'CriterionResult', 'CriticReview'}
+TOOL_NAMES = {'lexical_search', 'query_embedding', 'vector_search', 'resume_embedding', 'index_save'}
+ISSUE_TYPES = {'missing_evidence', 'conflicting_evidence', 'score_error',
+               'cross_domain_conflict', 'invalid_output', 'other'}
+RESOLUTIONS = {'open', 'rechecking', 'resolved', 'accepted_risk'}
+DOMAINS = ('resume_completeness', 'job_fit', 'qualifications', 'practical_competitiveness')
+CRITERION_CODES = {f'{domain}{number}' for domain in 'ABCD' for number in range(1, 4)}
+STAGES = {'parse_resume', 'parse_job', 'resume_embedding', 'index_save', 'criterion_evaluation',
+          'evaluation_graph', 'match_result_save', 'report_render', 'report_sql_save',
+          'report_file_write', 'evaluation_total', 'execution_report_render',
+          'execution_report_sql_save', 'execution_report_file_write'}
+VERSION_TOKEN = re.compile(r'[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,119}\Z')
