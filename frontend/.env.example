# Copy this file to .env. .env is ignored by Git.
# Local team API (start the compatible backend separately):
BACKEND_URL=http://127.0.0.1:5301
# Remote team API example: BACKEND_URL=https://api.example.com
# Origin only: no /api path, credentials, query, fragment, or API keys.
# Leave empty to serve static UI with an explicit API-unconfigured error.
FRONTEND_PORT=5300

# Optional: the browser-facing origin when using your own HTTPS reverse proxy.
# Render's default onrender.com URL is detected automatically.
# Set this only for an additional custom HTTPS domain.
# Supabase Site URL/redirect allowlist must match the browser-facing origin.
# PUBLIC_ORIGIN applies only to the preserved legacy backend, not current FastAPI.
# FRONTEND_PUBLIC_ORIGIN=https://careerlens.example.com
FRONTEND_PUBLIC_ORIGIN=

# Root start.bat: a blank/loopback BACKEND_URL launches the local backend.
# Set BACKEND_URL=https://your-api.example.com and restart start.bat to use
# an already deployed compatible API instead (no local backend is launched).
# The standalone server.py always connects to the exact configured origin.

# Local default. Set 0.0.0.0 only inside your deployment network/container.
FRONTEND_HOST=127.0.0.1
# PORT is also supported when the service-specific port is unset.

# Render: configure BACKEND_URL in the dashboard, not by uploading this file.
# Use the deployed FastAPI HTTPS origin; localhost points to Render itself.
# render.yaml passes $PORT explicitly and keeps automatic deployments off.
# Do not set CAREERLENS_JOB_POSTINGS_DIR to a Windows path on Render.
# A public fictional catalog snapshot is included for frontend-only deployments.

# Local guest analysis reuses the sibling CareerLens-backend engine and its
# server-side model configuration. Keep the team backend unchanged.
# Requires that engine's dependencies in the Python runtime. No keys in JS.
# Set 0 to disable new guest calculations (owned reports remain readable).
CAREERLENS_GUEST_ANALYSIS=1

# Full production wiring: infra/deploy/production.md and compose.yaml.
# Shared server-wide flow collection is not provided by the original backend.
# Model keys and DB credentials belong only in ignored server environment files.
