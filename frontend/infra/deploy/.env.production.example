# Copy to .env.production on the deployment host; never commit actual values.
CAREERLENS_DOMAIN=careerlens.example.com
FRONTEND_PUBLIC_ORIGIN=https://careerlens.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
OPENAI_API_KEY=
# Keep the team's verified model/rubric configuration.
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AUTH_ENABLED=true
CAREERLENS_GUEST_ANALYSIS=1
