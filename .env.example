# Fill credentials locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

DATABASE_URL=postgresql://postgres:password@localhost:5432/careerlens
# Generate a distinct secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ISSUER=careerlens
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
DATABASE_POOL_MAX_SIZE=10

APP_ENV=development
# Protected API routes require signed JWT authentication.
AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_MAX_BYTES=10485760
