# Fill credentials locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection for LangGraph checkpoints; URL-encode password characters.
SUPABASE_DB_URL=

APP_ENV=development
# Protected endpoints require authentication. Auth integration is not implemented yet.
AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_MAX_BYTES=10485760
